--- !u!114 &406445033
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 406445030}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fd9cd82e761c9db4bb9cc8d21780c8d5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: Samantha Job Interview
  snippet: "Sheppard:\nGood afternoon, Ms. Samantha. I\u2019ve read through your
    resume \u2014 quite a bit of volunteer work, I see.\n\nSamantha:\nYes! I really
    enjoy being involved outside the classroom. I think students learn best when
    they feel seen and supported, not just graded.\n\nSheppard:\nThat\u2019s a good
    philosophy. What would you say is your approach to discipline?\n\nSamantha:\nI
    start from understanding. Usually, when a student acts out, something else is
    going on \u2014 stress, family, identity, whatever it may be. If you talk to
    them like people, they almost always respond better.\n\nSheppard:\nAnd if they
    don\u2019t?\n\nSamantha:\nThen we talk again tomorrow. No one changes overnight.\n\n(Sheppard
    smiles, clearly impressed.)\n\nSheppard:\nWell, Ms. Samantha, thank you. I think
    our students would benefit from that perspective."
  tags:
  - 'Information '
  metadataJson: 
