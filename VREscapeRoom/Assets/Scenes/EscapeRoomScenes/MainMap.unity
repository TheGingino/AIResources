--- !u!114 &1384518428
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1384518425}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fd9cd82e761c9db4bb9cc8d21780c8d5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: John's job interview
  snippet: "Sheppard:\nGood morning, Mr. John. Thanks for coming in. You\u2019ve
    worked at a few schools in the city, I see?\n\nJohn:\nThat\u2019s right. Mostly
    in tougher neighborhoods \u2014 lots of different kinds of students. You learn
    to read people pretty quickly in those places.\n\nSheppard:\nRead people?\n\nJohn:\nJust,
    you know\u2026 who\u2019s likely to pay attention and who\u2019ll test your limits.
    Some kids come in ready to learn, others need firmer guidance. You can usually
    tell from day one.\n\nSheppard:\nInteresting. We like to think every student
    deserves the same chance to prove themselves here.\n\nJohn:\nOf course, absolutely.
    I\u2019m fair to everyone. I don\u2019t care where they\u2019re from \u2014 respect
    goes both ways. As long as they meet me halfway, we get along fine.\n\nSheppard:\nUnderstood.
    Well, thank you, Mr. John. We\u2019ll be in touch."
  tags:
  - 'Information '
  metadataJson: 
