  m_EditorClassIdentifier: 
  title: Maria
  snippet: "Maria Alves\n\nAge: 16\n\nAddress: 10 Hillcrest Avenue\n\nParent: Lucia
    Alves (single mother, works night shifts)\n\nNotes: Works part-time at a caf\xE9.
    Often tired in class. Has a dog named Bruno she talks about frequently. Social,
    kind, sometimes forgetful.\n\nPhone: 555-690-3421"
  tags:
  - 'Information '
  metadataJson: 
