  m_Script: {fileID: 11500000, guid: fd9cd82e761c9db4bb9cc8d21780c8d5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: Kafka
  snippet: "Always wears that black jacket, even in summer. Has this calm, unreadable
    expression that makes it hard to tell if she\u2019s paying attention or planning
    something. Elegant but manipulative. She knows how to make people do what she
    wants, even teachers. A little unsettling, honestly, but I can\u2019t deny she\u2019s
    bright. - Review done by Edward"
  tags:
  - 'Information '
  metadataJson: 
