  m_Name: 
  m_EditorClassIdentifier: 
  title: Imane
  snippet: 'Imane Rahmani


    Age: 17


    Address: 47 Maple Crescent


    Parents:
    Dr. and Mrs. Rahmani (both university professors)


    Notes: Very articulate
    and outspoken; clashes with teachers occasionally. Known for correcting staff
    mid-lesson. Active in debate club. Sensitive about grades.


    Email: imane.r@schoolmail.edu'
  tags:
  - 'Information '
  metadataJson: 
