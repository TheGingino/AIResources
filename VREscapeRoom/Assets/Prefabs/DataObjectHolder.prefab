--- !u!114 &4946675018458561500
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 550657345028756750}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fd9cd82e761c9db4bb9cc8d21780c8d5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: 'Jack Info '
  snippet: "Jack tries, but only when he feels like it. He lives with his older brother,
    and it\u2019s pretty clear he doesn\u2019t get much guidance at home. He zones
    out during class and doodles in his notebook \u2014 mostly little robots and
    spaceships. I think he wants to do something creative, but he\u2019s too afraid
    to fail. Has a weird habit of staying after class to \u201Cborrow\u201D markers.
    - Review done by Edward"
  tags:
  - 'Information '
  metadataJson: 
