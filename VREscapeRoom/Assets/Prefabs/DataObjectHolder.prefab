--- !u!114 &7599638784923554441
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2698309654168994047}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fd9cd82e761c9db4bb9cc8d21780c8d5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: Aino
  snippet: "Lives with her grandparents \u2014 very polite and dependable. She brings
    tea for group meetings and somehow makes everyone feel calmer. Her essays are
    immaculate, like she\u2019s proofreading for the universe. She doesn\u2019t talk
    about herself much, but the others clearly admire her. Probably too good for
    this class. - Review done by Samantha"
  tags:
  - 'Information '
  metadataJson: 
