  m_EditorClassIdentifier: 
  title: Maria
  snippet: "Age: 17\n\nAddress: 6 Pine Hollow Court\n\nLiving Situation: Unstable
    \u2014 temporarily staying with an uncle\n\nNotes: Low attendance; reported family
    conflict. Sometimes seen smoking near school grounds. Despite failing grades,
    shows aptitude for mechanics.\n\nEmail: dareck.holt@schoolmail.edu"
  tags:
  - 'Information '
  metadataJson: 
