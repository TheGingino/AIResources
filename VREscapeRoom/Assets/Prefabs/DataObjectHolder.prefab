--- !u!114 &935077766891676239
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 9120440564738058014}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fd9cd82e761c9db4bb9cc8d21780c8d5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: Imane
  snippet: "Imane thinks she\u2019s everyone\u2019s moral compass, which is exhausting.
    Smart, yes, but far too aware of it. She corrects me in front of the class sometimes
    \u2014 I doubt she realizes how arrogant that looks. Comes from a family that
    seems very invested in her \u201Cexcellence,\u201D which might explain the attitude.
    Honestly, I think she coasts on charm more than actual insight. - Review done
    by John"
  tags:
  - 'Information '
  metadataJson: 
