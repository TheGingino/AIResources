--- !u!114 &5136764767058638559
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1924546002463710793}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fd9cd82e761c9db4bb9cc8d21780c8d5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: Edward Job Interview
  snippet: "Sheppard:\nMr. Edward, thanks for coming in. Tell me \u2014 how would
    you describe your teaching style?\n\nEdward:\nEfficient. Structured. I don\u2019t
    believe in wasting time, mine or the students\u2019. I expect effort, and I give
    clarity in return.\n\nSheppard:\nAnd how do you handle students who don\u2019t
    meet those expectations?\n\nEdward:\nThey learn quickly that actions have consequences.
    I\u2019m fair, but I don\u2019t lower the bar. The world won\u2019t, either.\n\nSheppard:\nSome
    might say that\u2019s a bit rigid.\n\nEdward:\nDiscipline isn\u2019t rigidity
    \u2014 it\u2019s consistency. Kids know exactly where they stand with me. No
    surprises, no favoritism.\n\n(Sheppard nods, expression mixed \u2014 respectful
    but wary.)\n\nSheppard:\nThank you, Mr. Edward. You\u2019ve given me a clear
    picture of your approach."
  tags:
  - 'Information '
  metadataJson: 
